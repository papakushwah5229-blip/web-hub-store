:root[data-theme="dark"]{--bg:#070a1a;--panel:rgba(255,255,255,.07);--glass:rgba(16,20,46,.58);--dlg:rgba(18,22,52,.84);--ink:#f1f4ff;--mute:#aab3d6;--line:rgba(255,255,255,.14);--edge:rgba(255,255,255,.16);--acc:#a5b4ff;--acc2:rgba(165,180,255,.16);--accink:#0a0d24;--field:rgba(255,255,255,.07);--cardbg:linear-gradient(160deg,rgba(255,255,255,.11),rgba(255,255,255,.04));--sh:0 14px 40px -16px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.14);--o1:rgba(124,58,237,.55);--o2:rgba(37,99,235,.5);--o3:rgba(6,182,212,.38);color-scheme:dark}
/* ===== Glass theme ===== */
.orbs{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.orbs i{position:absolute;width:48vmax;height:48vmax;border-radius:50%;background:radial-gradient(circle,var(--o) 0,transparent 65%);animation:drift 24s ease-in-out infinite alternate;will-change:transform}
.orbs i:nth-child(1){--o:var(--o1);top:-16vmax;left:-12vmax}
.orbs i:nth-child(2){--o:var(--o2);top:-6vmax;right:-16vmax;animation-delay:-8s}
.orbs i:nth-child(3){--o:var(--o3);bottom:-22vmax;left:28%;animation-delay:-15s}
@keyframes drift{to{transform:translate3d(5vw,4vh,0) scale(1.1)}}
.side,.top,.pm,dialog,.toast{backdrop-filter:blur(20px) saturate(1.35);-webkit-backdrop-filter:blur(20px) saturate(1.35)}
