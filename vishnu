 <button class="nav" id="sidetheme" style="margin-top:auto"></button>
</aside>
<div class="scrim" id="scrim"></div>
<div class="main">
 <header class="top">
  <button class="ib burger" id="burger" aria-label="Open menu" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
  <span class="brand">WEB HUB STORE</span>
  <div class="search" role="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="q" type="search" placeholder="Search websites..." aria-label="Search websites" autocomplete="off"><kbd>/</kbd></div>
  <span class="sp"></span>
  <button class="ib" id="owner" aria-label="Unlock owner mode"></button>
  <button class="btn pri" data-go="add" id="topadd"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>Add Website</span></button>
  <button class="ib" id="theme" aria-label="Toggle dark mode"></button>
  <div class="pwrap"><button class="ib" id="pbtn" aria-label="Account menu" aria-haspopup="true" aria-expanded="false"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg></button><div class="pm" id="pm" hidden></div></div>
 </header>
 <main class="wrap" id="view" tabindex="-1"></main>
</div>
</div>

<dialog id="dlg" aria-labelledby="dtitle">
 <form id="form" class="f" novalidate>
  <div class="dh"><h2 id="dtitle">Add website</h2></div>
  <div class="db">
   <div><label for="fn">Website name</label><input id="fn" required maxlength="60" placeholder="e.g. Notion"></div>
   <div><label for="fu">Website URL</label><input id="fu" required placeholder="https://www.example.com" inputmode="url"></div>
   <div><label for="fd">Description</label><textarea id="fd" maxlength="140" placeholder="What do you use it for?"></textarea></div>
   <div><label for="fc">Category</label><select id="fc"></select></div>
   <div><label for="fnc">Or create a new category</label><input id="fnc" maxlength="30" placeholder="Leave empty to use the category above"></div>
   <div><label for="fi">Website icon/logo URL (optional)</label><input id="fi" inputmode="url" placeholder="https://example.com/logo.png"><small>Leave empty to use the Web Hub Store logo.</small></div>
   <label class="chk"><input type="checkbox" id="ff"> Add to favorites</label>
   <div class="err" id="ferr" role="alert"></div>
  </div>
  <div class="df"><button type="button" class="btn" id="fcancel">Cancel</button><button class="btn pri" id="fsave">Add Website</button></div>
 </form>
</dialog>

<dialog id="cdlg" aria-labelledby="ctitle">
 <div class="dh"><h2 id="ctitle">Are you sure?</h2></div>
 <div class="db"><p class="sub" id="cmsg"></p></div>
 <div class="df"><button class="btn" id="cno">Cancel</button><button class="btn dng" id="cyes">Delete</button></div>
</dialog>
<dialog id="pdlg" aria-labelledby="ptitle">
 <form id="pform" class="f" novalidate>
  <div class="dh"><h2 id="ptitle">Owner access</h2></div>
  <div class="db"><p class="sub" id="pmsg"></p>
   <div><label for="pin1" id="pl1">PIN</label><input id="pin1" type="password" inputmode="numeric" autocomplete="off" maxlength="8"></div>
   <div id="pg2"><label for="pin2">Confirm PIN</label><input id="pin2" type="password" inputmode="numeric" autocomplete="off" maxlength="8"></div>
   <div class="err" id="perr" role="alert"></div></div>
  <div class="df"><button type="button" class="btn" id="pcancel">Cancel</button><button class="btn pri" id="psave">Unlock</button></div>
 </form>
</dialog>
<div id="toasts" aria-live="polite"></div>

<script>
(function(){
'use strict';
var KEY='mywebhub.v2';
var DEFCATS=['Education','AI Tools','Google Tools','Social Media','Business','Government','Banking','Shopping','Entertainment','Design','Video Editing','Development','Other'];
var ICON={
 home:'<path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/>',
 all:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
 cats:'<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
 favs:'<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
 add:'<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>',
 settings:'<circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.5-2-3.4-2.3 1a7 7 0 0 0-2-1.2L14.2 3h-4l-.4 2.7a7 7 0 0 0-2 1.2l-2.3-1-2 3.4 2 1.5a7 7 0 0 0 0 2.4l-2 1.5 2 3.4 2.3-1a7 7 0 0 0 2 1.2l.4 2.7h4l.4-2.7a7 7 0 0 0 2-1.2l2.3 1 2-3.4-2-1.5c.1-.4.1-.8.1-1.2z"/>',
 clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
 sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
 moon:'<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/>',
 edit:'<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13.5 6.5 4 4"/>',
 trash:'<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>',
 ext:'<path d="M14 4h6v6M20 4 10 14M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
 globe:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
 x:'<path d="M6 6l12 12M18 6 6 18"/>'
};
ICON.recent=ICON.clock;ICON.lock='<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>';ICON.unlock='<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 7.5-2"/>';
function ic(n){return '<svg viewBox="0 0 24 24" aria-hidden="true">'+ICON[n]+'</svg>'}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6)}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}

var ICONS={'akkistudyxpro-44094a367971.herokuapp.com':'data:image/webp;base64,',
'asmultiverse.in':'data:image/webp;base64,',
'codextrms.in':'data:image/webp;base64,',
'deltastudy.fun':'data:image/webp;base64,',
'deltaverse.site':'data:image/webp;base64,',
'learnxpw.site':'data:image/webp;base64,',
'pwthor.live':'data:image/webp;base64,',
'spidygaurav.cc.cd':'data:image/webp;base64,',
'spidyuniverse.in':'data:image/webp;base64,',
'studybeepro.in':'data:image/webp;base64,',
'studypanda.live':'data:image/webp;base64,',
'studyparcham.in':'data:image/webp;base64,',
'studyratna.cc':'data:image/webp;base64,',
'studyrays.cc':'data:image/webp;base64,'};
var EXTRA=[['Delta study','https://deltastudy.fun/','vishnu kushwah education','Development'],
 ['Study Bee pro','https://studybeepro.in/','all student free class','Education'],
 ['Study panda','https://studypanda.live/','free class all','Education'],
 ['STUDY RATNA','https://studyratna.cc/','FREE EDUCATION IN INDIA','Education']];
function migrate(r){if(r.v>=3)return;r.v=3;var have={};
 r.sites.forEach(function(s){var h=host(s.url);have[h]=1;if(!s.icon&&ICONS[h])s.icon=ICONS[h]});
 EXTRA.forEach(function(x,i){if(have[host(x[1])])return;r.sites.push({id:uid()+'x'+i,name:x[0],url:x[1],desc:x[2],cat:x[3],color:hue(x[0]),icon:ICONS[host(x[1])]||'',fav:false,added:Date.now()-i,opened:0})})}
function seed(){
 var d=[['LearnXPW','https://www.learnxpw.site/study','Study and learning platform','Education'],
 ['DeltaVerse','https://deltaverse.site/institutes','Institute and educational resources','Education'],
 ['PWThor','https://pwthor.live/study/batches','Study batches and educational resources','Education'],
 ['AS Multiverse','https://asmultiverse.in/','Educational learning platform','Education'],
 ['Spidy Universe','https://spidyuniverse.in/','Study and educational resources','Education'],
 ['Spidy Gaurav','https://spidygaurav.cc.cd/','Educational resources','Education'],
 ['Study Rays','https://studyrays.cc/','Study resources and learning platform','Education'],
 ['Study Parcham','https://studyparcham.in/','Educational study resources','Education'],
 ['CodeX TRMS','https://www.codextrms.in/','Learning and technical resources','Development'],
 ['Aki Study X Pro','https://akkistudyxpro-44094a367971.herokuapp.com/app','Study and learning application','Education']].concat(EXTRA);
 var t=Date.now();
 return {sites:d.map(function(x,i){return {id:uid()+i,name:x[0],url:x[1],desc:x[2],cat:x[3],color:hue(x[0]),icon:ICONS[host(x[1])]||'',fav:false,added:t-i*1000,opened:0}}),cats:DEFCATS.slice(),recent:[],favs:{},theme:null,v:3};
}
function load(){try{var r=JSON.parse(localStorage.getItem(KEY));if(r&&Array.isArray(r.sites)&&Array.isArray(r.cats)){if(!Array.isArray(r.recent))r.recent=[];if(!r.favs)r.favs={};migrate(r);return r}}catch(e){}return seed()}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
var S=load();
var V={view:'home',cat:'',sort:'name',q:''};
var $=function(id){return document.getElementById(id)};
var LOGO=document.querySelector('.logo img').src;
document.querySelector('.brand').innerHTML='<img src="'+LOGO+'" alt="">WEB HUB STORE';
var SHARED=false,DB=null,ME=null;
function menu(){
 var nm=(ME&&ME.name)||(SHARED?'Signed in':'Local mode'),em=(ME&&ME.email)||(SHARED?'Email not shared':'Not signed in. Data stays on this device.');
 $('pm').innerHTML='<div class="who"><div class="av">'+esc(nm.charAt(0).toUpperCase())+'</div><div style="min-width:0"><strong>'+esc(nm)+'</strong><div class="em">'+esc(em)+'</div><span class="role">'+(OWNER?'Owner':'Viewer')+'</span></div></div>'+
 '<p class="em" style="margin:0">'+(OWNER?'Only you can add, edit or delete websites.':'Only the owner can add, edit or delete websites.')+'</p>'+
 (OWNER?'<button class="btn pri" data-go="add">'+ic('add')+'Add Website</button>':'')+
 '<button class="btn" data-go="settings">'+ic('settings')+'Settings</button>'+
 '<button class="btn" data-act="owner">'+ic('lock')+(OWNER?'Lock owner mode':'Unlock with PIN')+'</button>'}
function fail(){toast('Could not save. Only the owner can change the shared list.')}
function clean(s){return {name:s.name,url:s.url,desc:s.desc||'',cat:s.cat,color:s.color||'',icon:s.icon||'',added:s.added||Date.now()}}
function persist(s){if(!SHARED)return;if(s.fav)S.favs[s.id]=1;else delete S.favs[s.id];DB.collection('sites').doc(s.id).set(clean(s)).catch(fail)}
function persistCats(){if(SHARED)DB.doc('meta/config').set({cats:S.cats}).catch(fail)}
var OWNER=false,pmode='';try{OWNER=sessionStorage.getItem('mywebhub.owner')==='1'}catch(e){}
function hp(p){var h=5381,s='hub'+p;for(var i=0;i<s.length;i++)h=((h<<5)+h+s.charCodeAt(i))|0;return h.toString(36)}
var tries=0,lockUntil=0,PINH=hp('5229');
function setOwner(v){OWNER=v;try{sessionStorage.setItem('mywebhub.owner',v?'1':'0')}catch(e){}}
function pinDialog(mode){pmode=mode;var set=mode!=='unlock';
 $('ptitle').textContent=mode==='set'?'Set owner PIN':mode==='change'?'Change owner PIN':'Unlock owner mode';
 $('pmsg').textContent=set?'Choose a 4–8 digit PIN. Only the owner needs it to add, edit or delete websites.':'Enter your owner PIN.';
 $('pl1').textContent=set?'New PIN':'PIN';$('pg2').style.display=set?'':'none';$('psave').textContent=set?'Save PIN':'Unlock';
 $('pin1').value='';$('pin2').value='';$('perr').textContent='';closeSide();$('pdlg').showModal();$('pin1').focus()}
function needOwner(){toast('Enter the owner PIN to continue');pinDialog('unlock')}
function toggleOwner(){if(OWNER){setOwner(false);toast('Owner mode locked');render()}else pinDialog('unlock')}
$('pform').addEventListener('submit',function(e){e.preventDefault();var p=$('pin1').value.trim(),er=$('perr');
 if(!/^\d{4,8}$/.test(p)){er.textContent='Use 4 to 8 digits.';return}
 if(pmode==='unlock'){if(Date.now()<lockUntil){er.textContent='Too many attempts. Wait '+Math.ceil((lockUntil-Date.now())/1000)+' seconds.';return}if(hp(p)!==PINH){if(++tries>=5){tries=0;lockUntil=Date.now()+30000}er.textContent='Wrong PIN. Try again.';return}tries=0;setOwner(true);toast('Owner mode unlocked')}
 else{if(p!==$('pin2').value.trim()){er.textContent='The two PINs don’t match.';return}S.pin=hp(p);save();setOwner(true);toast(pmode==='change'?'PIN changed':'Owner PIN set. Owner mode unlocked')}
 $('pdlg').close();render()});
$('pcancel').addEventListener('click',function(){$('pdlg').close()});
$('owner').addEventListener('click',toggleOwner);
$('pbtn').addEventListener('click',function(){var o=$('pm').hidden;if(o){menu();$('pm').hidden=false}else $('pm').hidden=true;this.setAttribute('aria-expanded',String(o))});
$('pm').addEventListener('click',function(e){if(e.target.closest('button'))setTimeout(closeMenu,0)});
document.addEventListener('click',function(e){if(!e.target.closest('.pwrap'))closeMenu()});

function hue(name){var h=0;for(var i=0;i<name.length;i++)h=(h*31+name.charCodeAt(i))%360;return 'hsl('+h+' 55% 42%)'}
function host(u){try{return new URL(u).hostname.replace(/^www\./,'')}catch(e){return u}}
function normUrl(v){v=v.trim();if(!v)return null;if(!/^[a-z][a-z0-9+.-]*:/i.test(v))v='https://'+v;try{var u=new URL(v);if(u.protocol!=='http:'&&u.protocol!=='https:')return null;if(u.hostname.indexOf('.')<0&&u.hostname!=='localhost')return null;return u.href}catch(e){return null}}
function byId(id){return S.sites.filter(function(s){return s.id===id})[0]}

function toast(m){var t=document.createElement('div');t.className='toast';t.textContent=m;$('toasts').appendChild(t);setTimeout(function(){t.remove()},2600)}

/* theme */
function applyTheme(){
 var t=S.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
 document.documentElement.setAttribute('data-theme',t);
 $('theme').innerHTML=ic(t==='dark'?'sun':'moon');
 $('theme').setAttribute('aria-label',t==='dark'?'Switch to light mode':'Switch to dark mode');
 $('sidetheme').innerHTML=ic(t==='dark'?'sun':'moon')+(t==='dark'?'Light Mode':'Dark Mode');
}

/* filtering */
function matches(s,q){
 var hay=(s.name+' '+s.url+' '+s.desc+' '+s.cat).toLowerCase();
 return q.toLowerCase().split(/\s+/).filter(Boolean).every(function(w){return hay.indexOf(w)>-1});
}
function list(base){
 var r=base.filter(function(s){return (!V.cat||s.cat===V.cat)&&(!V.q||matches(s,V.q))});
 var c={name:function(a,b){return a.name.localeCompare(b.name)},
  za:function(a,b){return b.name.localeCompare(a.name)},
  newest:function(a,b){return b.added-a.added},
  opened:function(a,b){return b.opened-a.opened},
  fav:function(a,b){return (b.fav-a.fav)||a.name.localeCompare(b.name)}}[V.sort];
 return r.sort(c);
}

/* render pieces */
function ago(t){var m=Math.round((Date.now()-t)/60000);if(m<1)return 'just now';if(m<60)return m+' min ago';var h=Math.round(m/60);if(h<24)return h+' hr ago';return Math.round(h/24)+' d ago'}
function card(s,sub){
 var ico='<img src="'+esc(s.icon||LOGO)+'" alt=""'+(s.icon?' data-fallback':'')+'>';
 return '<article class="card"><div class="ch"><div class="ico lg">'+ico+'</div>'+
 '<div class="meta"><h3 title="'+esc(s.name)+'">'+esc(s.name)+'</h3><span class="host">'+esc(sub||host(s.url))+'</span></div>'+
 '<button class="star" data-act="fav" data-id="'+s.id+'" aria-pressed="'+!!s.fav+'" aria-label="'+(s.fav?'Remove '+esc(s.name)+' from favorites':'Add '+esc(s.name)+' to favorites')+'">'+ic('favs')+'</button></div>'+
 '<p>'+(esc(s.desc)||'No description yet.')+'</p>'+
 '<div><span class="tag">'+esc(s.cat)+'</span></div>'+
 '<div class="cf"><a class="btn pri open" href="'+esc(s.url)+'" target="_blank" rel="noopener noreferrer" data-act="open" data-id="'+s.id+'" aria-label="Open '+esc(s.name)+'">'+ic('ext')+'<span>Open Website</span></a>'+
 '<button class="btn eb" data-act="edit" data-id="'+s.id+'" aria-label="Edit '+esc(s.name)+'">'+ic('edit')+'<span>Edit</span></button>'+
 '<button class="btn eb d" data-act="del" data-id="'+s.id+'" aria-label="Delete '+esc(s.name)+'">'+ic('trash')+'<span>Delete</span></button></div></article>';
}
function grid(arr,tm){return '<div class="grid">'+arr.map(function(s){return card(s,tm&&s._t?'Opened '+ago(s._t):'')}).join('')+'</div>'}
function empty(title,msg,btn){return '<div class="empty">'+ic('globe')+'<h3>'+title+'</h3><div>'+msg+'</div>'+(btn||'')+'</div>'}
function addbtn(){return OWNER?'<button class="btn pri" data-go="add">'+ic('add')+'Add Website</button>':''}
function tools(n,total){
 var so=[['name','Name A–Z'],['za','Name Z–A'],['newest','Newest first'],['opened','Recently opened'],['fav','Favorites first']].map(function(x){return '<option value="'+x[0]+'"'+(V.sort===x[0]?' selected':'')+'>'+x[1]+'</option>'}).join('');
 var chips=[''].concat(S.cats).map(function(c){return '<button class="chip" data-act="chip" data-cat="'+esc(c)+'" aria-pressed="'+(V.cat===c)+'">'+(c?esc(c):'All')+'</button>'}).join('');
 return '<div class="chips" role="group" aria-label="Filter by category">'+chips+'</div><div class="tools"><span class="count" aria-live="polite">'+n+' of '+total+' website'+(total===1?'':'s')+(V.q?' matching “'+esc(V.q)+'”':'')+'</span><label class="sub" for="fsort">Sort</label><select id="fsort">'+so+'</select></div>';
}
function listView(title,sub,base,noRes){
 var r=list(base);
 return '<h1>'+title+'</h1><p class="sub">'+sub+'</p>'+tools(r.length,base.length)+(r.length?grid(r):
  (base.length?empty('No websites found','Try another search or add a new website.',addbtn()+' <button class="btn" data-act="clear">Clear search and filters</button>'):noRes));
}
function recentList(){return S.recent.map(function(x){var s=byId(x.id);if(!s)return null;var c=Object.assign({},s);c._t=x.time;return c}).filter(Boolean).slice(0,10)}

function views(){
 var v=V.view,favs=S.sites.filter(function(s){return s.fav});
 if(v==='home'){
  var rec=recentList(),total=S.sites.length;
  return '<section class="hero"><div class="hero-t"><span class="pill">'+S.sites.length+' websites saved</span><h1>All Your Websites in One Place</h1><p>Quickly access, organize and manage your favorite websites.</p><div class="hero-a"><button class="btn hb" data-go="all">Browse websites</button>'+(OWNER?'<button class="btn hg" data-go="add">'+ic('add')+'Add Website</button>':'')+'</div></div><div class="hero-art"><img src="'+LOGO+'" alt="" width="150" height="150"></div></section>'+
  '<div class="stats">'+[['all',total,'Total Websites','all'],['favs',favs.length,'Favorites','favs'],['cats',S.cats.length,'Categories','cats'],['clock',recentList().length,'Recently Opened','recent']].map(function(x){
   return '<button class="stat" data-go="'+x[3]+'">'+ic(x[0])+'<div><strong>'+x[1]+'</strong><span>'+x[2]+'</span></div></button>'}).join('')+'</div>'+
  '<h2>Recently opened <small>latest 10</small></h2>'+(rec.length?grid(rec,1):empty('Nothing opened yet','Websites you open from here show up in this list.'))+
  '<h2>Favorites</h2>'+(favs.length?grid(favs.slice(0,6)):empty('No favorites yet','Tap the star on any website to pin it here.'));
 }
 if(v==='recent'){var rl=recentList();return '<h1>Recently Opened</h1><p class="sub">Your latest 10 opened websites, newest first.</p><div style="height:20px"></div>'+(rl.length?grid(rl,1):empty('Nothing opened yet','Websites you open from your hub show up here.'))}
 if(v==='all')return listView('All Websites',S.sites.length+' saved links',S.sites,empty('No websites saved',OWNER?'Add your first website to start building your hub.':'Unlock owner mode to add your first website.',addbtn()));
 if(v==='favs')return listView('Favorites','Your starred websites',favs,empty('No favorites yet','Tap the star on any website to add it here.'));
 if(v==='cats'){
  return '<h1>Categories</h1><p class="sub">Group your websites. Create your own categories too.</p>'+
  '<form class="catform" id="catform" style="margin-top:20px"><input id="newcat" maxlength="30" placeholder="New category name" aria-label="New category name"><button class="btn pri">'+ic('add')+'Create category</button></form>'+
  '<div class="cats">'+S.cats.map(function(c){var n=S.sites.filter(function(s){return s.cat===c}).length;
   return '<div class="cat"><button class="go" data-act="catgo" data-cat="'+esc(c)+'"><strong>'+esc(c)+'</strong><span>'+n+' website'+(n===1?'':'s')+'</span></button>'+
   (DEFCATS.indexOf(c)<0?'<button class="ib d" data-act="delcat" data-cat="'+esc(c)+'" aria-label="Delete category '+esc(c)+'">'+ic('trash')+'</button>':'')+'</div>'}).join('')+'</div>';
 }
 if(v==='settings')return '<h1>Settings</h1><p class="sub">'+(SHARED?(OWNER?'Shared list: owner mode is on. Changes you make are visible to everyone.':'Shared list: view only. Unlock with the owner PIN to add websites. Favorites and recently opened stay on your device.'):'Your data lives in this browser’s storage.')+'</p>'+
  '<div class="panel"><h3>Appearance</h3><p class="sub">Choose how Web Hub Store looks.</p><div class="row"><label class="sub" for="themesel" style="align-self:center">Theme</label><select id="themesel" class="tsel">'+[['','System default'],['light','Light'],['dark','Dark']].map(function(x){return '<option value="'+x[0]+'"'+((S.theme||'')===x[0]?' selected':'')+'>'+x[1]+'</option>'}).join('')+'</select></div></div>'+
  '<div class="panel"><h3>Owner access</h3><p class="sub">'+(OWNER?'Owner mode is on. You can add, edit and delete websites.':'Locked. Enter the owner PIN to add, edit or delete websites.')+'</p><div class="row"><button class="btn pri" data-act="owner">'+(OWNER?'Lock owner mode':'Unlock with PIN')+'</button>'+'</div></div>'+
  '<div class="panel own localonly"><h3>Backup and restore</h3><p class="sub">Copy your data as text, or paste a backup below and restore it.</p><textarea class="bk" id="bk" aria-label="Backup data" spellcheck="false"></textarea><div class="row"><button class="btn" data-act="export">Fill with my data</button><button class="btn" data-act="copy">Copy</button><button class="btn pri" data-act="import">Restore from text</button></div></div>'+
  '<div class="panel own localonly"><h3>Reset</h3><div class="row"><button class="btn" data-act="clearrec">Clear recently opened</button><button class="btn dng" data-act="reset">Reset to default websites</button></div></div>';
 return '';
}

function render(keepFocus){
 document.querySelector('.app').classList.toggle('viewer',!OWNER);
 $('topadd').style.display=OWNER?'':'none';
 $('owner').innerHTML=ic(OWNER?'unlock':'lock');
 $('owner').setAttribute('aria-label',OWNER?'Lock owner mode':'Unlock owner mode');$('owner').title=OWNER?'Owner mode on — click to lock':'Owner login';
 var navItems=[['home','Dashboard'],['all','All Websites'],['favs','Favorites'],['cats','Categories'],['recent','Recently Opened'],['add','Add Website'],['settings','Settings']];
 $('nav').innerHTML=navItems.filter(function(n){return OWNER||n[0]!=='add'}).map(function(n){var cnt=n[0]==='all'?S.sites.length:n[0]==='favs'?S.sites.filter(function(s){return s.fav}).length:'';
  return '<button class="nav" data-go="'+n[0]+'"'+(V.view===n[0]?' aria-current="page"':'')+'>'+ic(n[0])+n[1]+(cnt!==''?'<b>'+cnt+'</b>':'')+'</button>'}).join('');
 var m=$('view');m.innerHTML='<div class="view">'+views()+'</div>';
 var bad=m.querySelectorAll('img[data-fallback]');
 Array.prototype.forEach.call(bad,function(im){im.addEventListener('error',function(){im.removeAttribute('data-fallback');im.src=LOGO})});
}

/* navigation */
function go(v){
 if(v==='add'){openForm();return}
 if(v!==V.view){V.view=v;if(v!=='all'&&v!=='favs'){V.cat='';}}
 closeSide();render();window.scrollTo(0,0);
}
function openSide(){$('side').classList.add('open');$('scrim').classList.add('open');$('burger').setAttribute('aria-expanded','true')}
function closeMenu(){$('pm').hidden=true;$('pbtn').setAttribute('aria-expanded','false')}
function closeSide(){closeMenu();$('side').classList.remove('open');$('scrim').classList.remove('open');$('burger').setAttribute('aria-expanded','false')}

/* form */
var editing=null;
function fillCats(sel){$('fc').innerHTML=S.cats.map(function(c){return '<option'+(c===sel?' selected':'')+'>'+esc(c)+'</option>'}).join('')}
function openForm(id){
 if(!OWNER){needOwner();return}
 editing=id?byId(id):null;var s=editing||{};
 $('dtitle').textContent=editing?'Edit website':'Add website';
 $('fsave').textContent=editing?'Save changes':'Add Website';
 $('fn').value=s.name||'';$('fu').value=s.url||'';$('fd').value=s.desc||'';$('fi').value=(s.icon&&s.icon.indexOf('data:')===0)?'':(s.icon||'');$('fnc').value='';$('ff').checked=!!s.fav;
 fillCats(s.cat||(V.cat||'Other'));$('ferr').textContent='';closeSide();
 $('dlg').showModal();$('fn').focus();
}
$('form').addEventListener('submit',function(e){
 e.preventDefault();
 if(!OWNER){return}
 var name=$('fn').value.trim(),url=normUrl($('fu').value),icon=$('fi').value.trim(),err=$('ferr');
 if(!name){err.textContent='Enter a website name.';$('fn').focus();return}
 if(!url){err.textContent='Enter a valid URL, for example https://www.example.com.';$('fu').focus();return}
 if(icon&&!normUrl(icon)){err.textContent='The icon URL must start with http:// or https://.';$('fi').focus();return}
 var cat=$('fc').value,nc=$('fnc').value.trim();
 if(nc){var ex=S.cats.filter(function(c){return c.toLowerCase()===nc.toLowerCase()})[0];if(ex)cat=ex;else{S.cats.push(nc);cat=nc}}
 var data={name:name,url:url,desc:$('fd').value.trim(),cat:cat,icon:(editing&&editing.icon&&editing.icon.indexOf('data:')===0&&!icon)?editing.icon:(icon?normUrl(icon):''),fav:$('ff').checked};
 if(editing){Object.assign(editing,data);toast('Website updated successfully!')}
 else{S.sites.unshift(Object.assign({id:uid(),color:hue(name),added:Date.now(),opened:0},data));toast('Website added successfully!')}
 persist(editing||S.sites[0]);if(nc)persistCats();save();$('dlg').close();render();
});
$('fcancel').addEventListener('click',function(){$('dlg').close()});

/* confirm */
var onYes=null;
function confirmBox(title,msg,label,fn){$('ctitle').textContent=title;$('cmsg').textContent=msg;$('cyes').textContent=label;onYes=fn;$('cdlg').showModal();$('cno').focus()}
$('cno').addEventListener('click',function(){$('cdlg').close()});
$('cyes').addEventListener('click',function(){$('cdlg').close();if(onYes)onYes();onYes=null});

/* actions */
function backupText(){return JSON.stringify(Object.assign({},S,{pin:undefined}),null,2)}
document.addEventListener('click',function(e){
 var g=e.target.closest('[data-go]');if(g){go(g.dataset.go);return}
 var a=e.target.closest('[data-act]');if(!a)return;
 var act=a.dataset.act,id=a.dataset.id,s=id?byId(id):null;
 if(['edit','del','delcat','export','copy','import','clearrec','reset','changepin'].indexOf(act)>-1&&!OWNER){needOwner();return}
 if(act==='open'&&s){var now=Date.now();s.opened=now;S.recent=[{id:s.id,name:s.name,time:now}].concat(S.recent.filter(function(x){return x.id!==s.id})).slice(0,10);save();toast('Opening '+s.name);setTimeout(function(){if(V.view==='home'||V.view==='recent')render()},200);return}
 if(act==='fav'&&s){s.fav=!s.fav;if(s.fav)S.favs[s.id]=1;else delete S.favs[s.id];save();render();toast(s.fav?'Added to favorites':'Removed from favorites')}
 else if(act==='edit')openForm(id);
 else if(act==='del'&&s)confirmBox('Are you sure you want to delete this website?',s.name+' will be removed from your hub. This can’t be undone.','Delete',function(){if(SHARED)DB.collection('sites').doc(id).delete().catch(fail);S.sites=S.sites.filter(function(x){return x.id!==id});S.recent=S.recent.filter(function(x){return x.id!==id});save();render();toast('Website deleted successfully!')});
 else if(act==='clear'){V.q='';V.cat='';$('q').value='';render()}
 else if(act==='owner')toggleOwner();
 else if(act==='changepin')pinDialog('change');
 else if(act==='chip'){V.cat=a.dataset.cat;render()}
 else if(act==='catgo'){V.cat=a.dataset.cat;V.view='all';render();window.scrollTo(0,0)}
 else if(act==='delcat'){var c=a.dataset.cat;confirmBox('Delete category “'+c+'”?','Websites in it move to “Other”.','Delete',function(){S.sites.forEach(function(x){if(x.cat===c){x.cat='Other';persist(x)}});S.cats=S.cats.filter(function(x){return x!==c});persistCats();save();render();toast('Category deleted')})}
 else if(act==='theme')$('theme').click();
 else if(act==='export')$('bk').value=backupText();
 else if(act==='copy'){var t=$('bk');if(!t.value)t.value=backupText();t.select();try{navigator.clipboard.writeText(t.value).then(function(){toast('Copied')},function(){document.execCommand('copy');toast('Copied')})}catch(x){try{document.execCommand('copy');toast('Copied')}catch(y){toast('Select the text and copy it manually')}}}
 else if(act==='import'){try{var r=JSON.parse($('bk').value);if(!r||!Array.isArray(r.sites)||!Array.isArray(r.cats))throw 0;if(!Array.isArray(r.recent))r.recent=[];r.pin=S.pin;if(!r.favs)r.favs={};migrate(r);S=r;save();applyTheme();render();toast('Backup restored')}catch(x){toast('That backup text isn’t valid')}}
 else if(act==='clearrec'){S.recent=[];S.sites.forEach(function(x){x.opened=0});save();render();toast('Recently opened cleared')}
 else if(act==='reset')confirmBox('Reset your hub?','All your websites and categories are replaced by your 10 default websites.','Reset',function(){var pn=S.pin;S=seed();S.pin=pn;save();applyTheme();render();toast('Hub reset')});
});
document.addEventListener('submit',function(e){
 if(e.target.id==='catform'){e.preventDefault();if(!OWNER){needOwner();return}var n=$('newcat').value.trim();
  if(!n){toast('Enter a category name');return}
  if(S.cats.some(function(c){return c.toLowerCase()===n.toLowerCase()})){toast('That category already exists');return}
  S.cats.push(n);persistCats();save();render();toast('Category “'+n+'” created')}
});
document.addEventListener('change',function(e){
 if(e.target.id==='fcat'){V.cat=e.target.value;render()}
 if(e.target.id==='fsort'){V.sort=e.target.value;render()}
 if(e.target.id==='themesel'){S.theme=e.target.value||null;save();applyTheme()}
});
$('q').addEventListener('input',function(){
 V.q=this.value.trim();
 if(V.q&&V.view!=='all'&&V.view!=='favs'){V.view='all';V.cat=''}
 render();
});
$('theme').addEventListener('click',function(){S.theme=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';save();applyTheme();if(V.view==='settings')render()});
$('burger').addEventListener('click',function(){if(matchMedia('(max-width:820px)').matches){$('side').classList.contains('open')?closeSide():openSide()}else{var h=document.querySelector('.app').classList.toggle('hide');this.setAttribute('aria-expanded',String(!h));this.setAttribute('aria-label',h?'Show sidebar':'Hide sidebar')}});
$('sidetheme').addEventListener('click',function(){$('theme').click()});
$('scrim').addEventListener('click',closeSide);
document.addEventListener('keydown',function(e){
 var t=e.target,typing=/INPUT|TEXTAREA|SELECT/.test(t.tagName);
 if(e.key==='/'&&!typing){e.preventDefault();$('q').focus()}
 if(e.key==='Escape'){closeSide();if(document.activeElement===$('q')&&$('q').value){$('q').value='';V.q='';render()}}
});
applyTheme();render();
try{matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){if(!S.theme)applyTheme()})}catch(e){}
if((navigator.deviceMemory&&navigator.deviceMemory<=2)||(navigator.hardwareConcurrency&&navigator.hardwareConcurrency<=2))document.documentElement.classList.add('lite');
(function(){
 var fine=matchMedia('(hover:hover) and (pointer:fine)'),rm=matchMedia('(prefers-reduced-motion:reduce)'),root=document.documentElement;
 var cur=null,raf=0,px=0,py=0,V=['--rx','--ry','--mx','--my','--tx','--ty'];
 function ok(){return fine.matches&&!rm.matches&&!root.classList.contains('lite')}
 function frame(){raf=0;if(!cur)return;var b=cur.getBoundingClientRect(),x=(px-b.left)/b.width,y=(py-b.top)/b.height,s=cur.style;
  s.setProperty('--ry',((x-.5)*10).toFixed(2)+'deg');s.setProperty('--rx',((.5-y)*8).toFixed(2)+'deg');
  s.setProperty('--mx',(x*100).toFixed(1)+'%');s.setProperty('--my',(y*100).toFixed(1)+'%');
  s.setProperty('--tx',((x-.5)*2).toFixed(2));s.setProperty('--ty',((y-.5)*2).toFixed(2))}
 function reset(c){if(!c)return;c.classList.remove('tilt');V.forEach(function(v){c.style.removeProperty(v)})}
 var view=$('view');
 view.addEventListener('pointermove',function(e){
  if(e.pointerType!=='mouse'||!ok())return;
  var c=e.target.closest('.card,.stat');
  if(c!==cur){reset(cur);cur=c;if(c)c.classList.add('tilt')}
  if(!c)return;px=e.clientX;py=e.clientY;if(!raf)raf=requestAnimationFrame(frame)});
 view.addEventListener('pointerleave',function(){reset(cur);cur=null;if(raf){cancelAnimationFrame(raf);raf=0}});
})();
})();
</script>
</body>
</html>
