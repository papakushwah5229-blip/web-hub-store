<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Web Hub Store</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f6fb;--panel:#fff;--glass:rgba(255,255,255,.72);--ink:#121a2e;--mute:#5f6b85;--line:#e2e7f1;--acc:#2f4bff;--acc2:#e9edff;--accink:#fff;--star:#f5a524;--danger:#d92d4b;--sh:0 1px 2px rgba(18,26,46,.05),0 8px 24px -12px rgba(18,26,46,.16);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root:not([data-theme="light"]){color-scheme:light dark}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1220;--panel:#151c2e;--glass:rgba(21,28,46,.72);--ink:#e8ecf7;--mute:#98a3bd;--line:#252e45;--acc:#7b92ff;--acc2:#1d2848;--accink:#0d1220;--sh:0 1px 2px rgba(0,0,0,.3),0 8px 24px -12px rgba(0,0,0,.6)}}
:root[data-theme="dark"]{--bg:#0d1220;--panel:#151c2e;--glass:rgba(21,28,46,.72);--ink:#e8ecf7;--mute:#98a3bd;--line:#252e45;--acc:#7b92ff;--acc2:#1d2848;--accink:#0d1220;--sh:0 1px 2px rgba(0,0,0,.3),0 8px 24px -12px rgba(0,0,0,.6)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",sans-serif;transition:background .25s,color .25s}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.app{display:flex;min-height:100vh}
.side{position:fixed;inset:0 auto 0 0;width:248px;background:var(--panel);border-right:1px solid var(--line);padding:calc(18px + env(safe-area-inset-top,0px)) 14px 18px;display:flex;flex-direction:column;gap:6px;z-index:30;transition:transform .25s}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:18px;padding:0 8px 16px;letter-spacing:-.01em}
.logo{justify-content:center;padding:0 0 14px}.logo img{background:#fff;border-radius:16px;padding:10px 14px;width:100%;max-width:200px;height:auto;display:block}
.logo i{width:32px;height:32px;border-radius:10px;background:var(--acc);color:var(--accink);display:grid;place-items:center;font-style:normal;font-size:15px}
.nav{display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border:0;background:none;border-radius:10px;color:var(--mute);font-weight:500;text-align:left;transition:background .15s,color .15s}
.nav:hover{background:var(--bg);color:var(--ink)}
.nav[aria-current=page]{background:var(--acc2);color:var(--acc)}
.nav b{margin-left:auto;font-size:12px;font-weight:600;background:var(--bg);color:var(--mute);border-radius:99px;padding:0 8px}
.side .foot{margin-top:auto;font-size:12px;color:var(--mute);padding:8px}
.main{margin-left:248px;flex:1;min-width:0}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:flex;align-items:center;gap:10px;padding:12px 28px;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.search{flex:1;max-width:560px;position:relative}
.search svg{position:absolute;left:12px;top:50%;translate:0 -50%;color:var(--mute)}
.search input{width:100%;height:42px;padding:0 70px 0 38px;border:1px solid var(--line);border-radius:12px;background:var(--panel);outline:0;transition:border-color .15s,box-shadow .15s}
.search input:focus{border-color:var(--acc);box-shadow:0 0 0 3px var(--acc2)}
.search kbd{position:absolute;right:10px;top:50%;translate:0 -50%;font-size:11px;color:var(--mute);border:1px solid var(--line);border-radius:6px;padding:0 6px}
.ib{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line);border-radius:12px;background:var(--panel);color:var(--mute);transition:color .15s,border-color .15s}
.ib:hover{color:var(--ink);border-color:var(--mute)}
.burger{display:grid}
.sp{margin-left:auto}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:var(--panel);font-weight:600;font-size:14px;text-decoration:none;transition:transform .12s,background .15s}
.btn:active{transform:scale(.97)}
.btn.pri{background:var(--acc);border-color:var(--acc);color:var(--accink)}
.btn.pri:hover{filter:brightness(1.08)}
.btn.dng{background:var(--danger);border-color:var(--danger);color:#fff}
.wrap{padding:28px;max-width:1280px;margin:0 auto}
.view{animation:vin .22s ease-out}
@keyframes vin{from{opacity:0;translate:0 6px}to{opacity:1;translate:0 0}}
h1{font-size:28px;letter-spacing:-.02em;margin:0 0 4px;line-height:1.2}
h2{font-size:17px;margin:32px 0 14px;display:flex;align-items:center;gap:10px}
h2 small{font-weight:500;color:var(--mute);font-size:13px}
.sub{color:var(--mute);margin:0}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:24px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px 18px;box-shadow:var(--sh);text-align:left;display:flex;gap:14px;align-items:center;transition:border-color .15s}
.stat:hover{border-color:var(--acc)}
.stat svg{width:46px;height:46px;padding:12px;border-radius:14px;background:linear-gradient(135deg,#2f4bff,#6d7cff);color:#fff}
.stat strong{display:block;font-size:30px;line-height:1.1}
.stat span{font-size:13px;color:var(--mute)}
.tools{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:22px 0 16px}
.tools select{height:38px;border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:0 10px}
.tools .count{color:var(--mute);font-size:13px;margin-right:auto}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:var(--sh);display:flex;flex-direction:column;gap:12px;transition:transform .18s,border-color .18s}
.card:hover{transform:translateY(-2px);border-color:var(--acc)}
.ch{display:flex;gap:12px;align-items:center}
.ico{width:58px;height:58px;border-radius:16px;background:var(--c);color:#fff;display:grid;place-items:center;font-weight:700;font-size:19px;flex:none;overflow:hidden}
.ico img{width:100%;height:100%;object-fit:cover}
.meta{min-width:0;flex:1}
.meta h3{margin:0;font-size:17.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.host{font-size:12.5px;color:var(--mute);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.star{width:36px;height:36px;border:0;background:none;border-radius:10px;color:var(--mute);display:grid;place-items:center}
.star:hover{background:var(--bg)}
.star[aria-pressed=true]{color:var(--star)}
.star[aria-pressed=true] svg{fill:currentColor}
.card p{margin:0;color:var(--mute);font-size:14.5px;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cf{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tag{font-size:12px;font-weight:600;color:var(--acc);background:var(--acc2);border-radius:99px;padding:2px 10px;margin-right:auto}
.cf .btn{height:34px;padding:0 12px;font-size:13px}
.cf .ib{width:34px;height:34px;border-radius:10px}
.cf .ib.d:hover{color:var(--danger);border-color:var(--danger)}
.cats{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
.cat{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:16px;display:flex;align-items:center;gap:12px;box-shadow:var(--sh);position:relative;transition:border-color .15s}
.cat:hover{border-color:var(--acc)}
.cat>button.go{all:unset;cursor:pointer;flex:1;min-width:0;display:block}
.cat>button.go:focus-visible{outline:2px solid var(--acc);outline-offset:6px;border-radius:8px}
.cat strong{display:block}
.cat span{font-size:13px;color:var(--mute)}
.cat .ib{width:30px;height:30px;border-radius:8px}
.catform{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}
.catform input,.f input,.f select,.f textarea,.bk{width:100%;border:1px solid var(--line);border-radius:10px;background:var(--bg);padding:10px 12px;outline:0}
.catform input{flex:1;min-width:200px;width:auto}
.f input:focus,.f select:focus,.f textarea:focus,.catform input:focus,.bk:focus{border-color:var(--acc);box-shadow:0 0 0 3px var(--acc2)}
.empty{text-align:center;border:1.5px dashed var(--line);border-radius:18px;padding:48px 20px;color:var(--mute)}
.empty svg{width:40px;height:40px;color:var(--acc);margin-bottom:8px}
.empty h3{color:var(--ink);margin:0 0 4px}
.empty .btn{margin-top:14px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:var(--sh);margin-top:18px}
.panel h3{margin:0 0 4px;font-size:16px}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.bk{min-height:110px;font:12px/1.4 ui-monospace,monospace;margin-top:12px;resize:vertical}
dialog{border:1px solid var(--line);border-radius:20px;background:var(--panel);color:var(--ink);padding:0;width:min(480px,calc(100vw - 24px));box-shadow:0 30px 80px -20px rgba(0,0,0,.45)}
dialog::backdrop{background:rgba(8,12,24,.5);backdrop-filter:blur(3px)}
dialog[open]{animation:vin .18s ease-out}
.dh{padding:20px 22px 0}.dh h2{margin:0;font-size:19px}
.db{padding:16px 22px;display:grid;gap:14px}
.f label{display:block;font-size:13px;font-weight:600;margin-bottom:5px}
.f textarea{resize:vertical;min-height:70px}
.f .chk{display:flex;align-items:center;gap:8px;font-weight:500}
.f .chk input{width:auto}
.f small{color:var(--mute);font-size:12px}
.err{color:var(--danger);font-size:13px;min-height:0}
.df{padding:0 22px 20px;display:flex;justify-content:flex-end;gap:10px}
#toasts{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));display:grid;gap:8px;z-index:60}
.toast{background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-size:14px;font-weight:500;box-shadow:var(--sh);animation:vin .2s ease-out}
.brand{display:none;font-weight:700;letter-spacing:.05em;font-size:14px}
.app.hide .side{transform:translateX(-100%)}.app.hide .main{margin-left:0}.app.hide .brand{display:block}
@media(max-width:820px){.brand{display:block}}
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 6px;margin-top:20px}
.chip{border:1px solid var(--line);background:var(--panel);border-radius:99px;padding:5px 14px;font-size:13px;font-weight:600;color:var(--mute);white-space:nowrap;transition:background .15s,color .15s}
.chip:hover{color:var(--ink)}.chip[aria-pressed=true]{background:var(--acc);border-color:var(--acc);color:var(--accink)}
.tools{margin-top:10px}
.cf .open{flex:1 0 100%}.cf .eb{flex:1}.cf .eb.d:hover{color:var(--danger);border-color:var(--danger)}
.tsel{height:38px;border:1px solid var(--line);border-radius:10px;background:var(--panel);padding:0 10px}
.viewer .eb,.viewer .own,.viewer .catform,.viewer [data-act=delcat]{display:none}
.ico.lg{background:#fff;border:1px solid var(--line)}.ico.lg img{object-fit:contain;padding:3px}
.shared .localonly{display:none}
.pwrap{position:relative}
.pm{position:absolute;right:0;top:48px;width:272px;background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:0 20px 50px -15px rgba(0,0,0,.4);padding:14px;z-index:40;animation:vin .15s ease-out}
.pm[hidden]{display:none}.pm .who{display:flex;gap:10px;align-items:center;margin-bottom:10px}
.av{width:40px;height:40px;border-radius:50%;background:var(--acc2);color:var(--acc);display:grid;place-items:center;font-weight:700;flex:none}
.em{font-size:12.5px;color:var(--mute);overflow-wrap:anywhere}
.role{display:inline-block;font-size:11px;font-weight:700;border-radius:99px;padding:1px 9px;background:var(--acc2);color:var(--acc);margin-top:3px}
.pm .btn{width:100%;margin-top:8px}
.hero{position:relative;overflow:hidden;border-radius:26px;padding:40px 44px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:28px;background:radial-gradient(520px 240px at 92% 0%,rgba(255,138,31,.38),transparent 62%),linear-gradient(120deg,#0f2460 0%,#2b45d9 100%);box-shadow:0 24px 50px -24px rgba(31,53,170,.7)}
.hero h1{color:#fff;font-size:36px;margin:14px 0 8px;max-width:15ch}
.hero p{margin:0;color:rgba(255,255,255,.82);max-width:46ch;font-size:16px}
.pill{display:inline-block;font-size:12.5px;font-weight:600;padding:4px 12px;border-radius:99px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25)}
.hero-a{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.hero .hb{background:#ff8a1f;border-color:#ff8a1f;color:#1a1200;height:42px;padding:0 18px}
.hero .hg{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.35);color:#fff;height:42px;padding:0 18px}
.hero-art{flex:none}.hero-art img{width:150px;height:150px;background:#fff;border-radius:28px;padding:12px;display:block;rotate:3deg;box-shadow:0 20px 40px -16px rgba(0,0,0,.5)}
.stats{margin-top:20px}
.cf .open{height:44px;font-size:14.5px;border:0;color:#fff;background:linear-gradient(135deg,#2f4bff,#5b6cff)}
.cf .open:hover{filter:brightness(1.1)}
.scrim{display:none}
@media(max-width:1000px){.stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:820px){
.side{transform:translateX(-100%)}
.side.open{transform:none;box-shadow:0 0 60px rgba(0,0,0,.35)}
.scrim.open{display:block;position:fixed;inset:0;background:rgba(8,12,24,.45);z-index:25}
.main{margin-left:0}.burger{display:grid}
.top{padding:10px 14px;flex-wrap:wrap}.search{order:5;flex-basis:100%;max-width:none}.sp{display:none}
#owner{margin-left:auto}
.wrap{padding:18px 14px}h1{font-size:23px}.hero{flex-direction:column-reverse;align-items:flex-start;padding:24px;gap:16px}.hero h1{font-size:27px}.hero-art img{width:84px;height:84px;padding:8px;border-radius:20px}
.grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.card{padding:14px}
.card .host{display:none}
}
@media(max-width:520px){.grid{grid-template-columns:1fr}.card .host{display:block}.cf .btn span{display:inline}.stat{padding:12px}.stat svg{width:34px;height:34px;padding:8px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
:root{--bg:#e9edfb;--panel:rgba(255,255,255,.55);--glass:rgba(255,255,255,.62);--dlg:rgba(255,255,255,.88);--ink:#0f1638;--mute:#46517a;--line:rgba(80,92,170,.25);--edge:rgba(255,255,255,.85);--acc:#4338ca;--acc2:rgba(67,56,202,.12);--accink:#fff;--field:rgba(255,255,255,.75);--cardbg:linear-gradient(160deg,rgba(255,255,255,.82),rgba(255,255,255,.5));--sh:0 14px 40px -18px rgba(60,70,160,.45),inset 0 1px 0 rgba(255,255,255,.95);--o1:rgba(167,139,250,.55);--o2:rgba(96,165,250,.5);--o3:rgba(34,211,238,.4);color-scheme:light}
